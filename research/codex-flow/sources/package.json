{
  "name": "openai-codex-electron",
  "productName": "Codex",
  "author": "OpenAI",
  "version": "26.1027.30824",
  "description": "Codex",
  "main": ".vite/build/early-bootstrap.js",
  "scripts": {
    "compile": "node ./scripts/ensure-owl-electron-types.mjs && node ../cli/run-package-typescript.mjs --build",
    "tsc": "node ./scripts/ensure-owl-electron-types.mjs && node ../cli/run-package-typescript.mjs",
    "dev": "pnpm --dir .. run app",
    "prepare:owl": "pnpm run owl:prepare-runtime && pnpm run desktop:host",
    "owl": "pnpm run prepare:owl && pnpm run owl:run",
    "owl:prepare-runtime": "node ./scripts/prepare-dev.mjs --native-modules",
    "owl:run": "cross-env NODE_ENV=development node ./scripts/owl-shell.mjs run -- --use-mock-keychain",
    "desktop:host": "cross-env NODE_ENV=development pnpm run build:dev-rspack",
    "build": "node -e \"require('node:fs').rmSync('out',{force:true,recursive:true})\" && cross-env PNPM_YES=true pnpm run forge:make",
    "forge:make": "pnpm run rebuild:native-modules && electron-forge make",
    "forge:make:owl-shell": "electron-forge make",
    "forge:publish": "pnpm run rebuild:native-modules && electron-forge publish",
    "owl:ensure": "node ./scripts/owl-shell.mjs ensure",
    "package": "node ./scripts/package.mjs",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "node ./scripts/ensure-owl-electron-types.mjs && node ../scripts/run-package-oxlint.mjs --include-top-level-ts-scripts",
    "lint:fix": "node ./scripts/ensure-owl-electron-types.mjs && node ../scripts/run-package-oxlint.mjs --include-top-level-ts-scripts --fix",
    "metadata-path": "pnpm exec tsx ./scripts/dev-metadata.ts path",
    "memory:analyze-snapshot": "node ./scripts/analyze-heap-snapshot.mjs",
    "test": "vitest run",
    "test:quiet": "vitest run --silent --reporter=dot",
    "e2e:computer-use-native-pipe": "node --import tsx ./scripts/computer-use-native-pipe-e2e.mjs",
    "playwright:agent:repl": "node --import tsx ./scripts/playwright-electron-agent-cdp.mjs",
    "devtools:reset": "node -e \"const fs=require('node:fs');const os=require('node:os');const path=require('node:path');for(const target of ['extensions/fmkadmapgofadopljbjfkapdkoienihi','Service Worker','Code Cache'])fs.rmSync(path.join(os.homedir(),'Library','Application Support','Codex',target),{force:true,recursive:true})\"",
    "rebuild:native-modules": "node ./scripts/owl-shell.mjs prepare-native-modules",
    "build:dev-rspack": "node --import tsx ./scripts/rspack/build.ts"
  },
