# Keep retained desktop bytes and generated provenance hashes stable on Windows.
migration/desktop-extensions/** -text whitespace=cr-at-eol,-blank-at-eof
probe/assets/desktop-extensions.js -text whitespace=cr-at-eol
probe/assets/desktop-extensions.css -text whitespace=cr-at-eol
probe/assets/desktop-authoring.cjs -text whitespace=cr-at-eol
probe/assets/native-plugin-add/** -text -whitespace
# Runtime resource hashes use canonical UTF-8/LF.
probe/assets/office/** text eol=lf
probe/assets/runtime/eva-runtime-arm64.tar.gz filter=lfs diff=lfs merge=lfs -text
outputs/runtime-sources/*.tar.gz filter=lfs diff=lfs merge=lfs -text

# Reproducible runtime build recipes and manifests.
tools/*.sh text eol=lf
probe/assets/runtime/*.json text eol=lf

# Generated reader/vendor bundles retain upstream bytes, including template whitespace.
probe/assets/desktop-reader/native-reader.js -text -whitespace
probe/assets/desktop-reader/office-browser.js -text -whitespace
probe/assets/desktop-reader/vendor/docx-current.mjs -text -whitespace
